# ============================================================
# FinancialAssistant 环境变量模板
# 复制为 .env 后填入真实密钥：  cp .env.example .env
# 注意：.env 已被 .gitignore 忽略，切勿提交真实密钥！
# ============================================================

# ---------- LLM：DeepSeek（OpenAI 兼容接口） ----------
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-your-deepseek-api-key
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
# 评估判官（LLM-as-Judge）专用模型：要便宜/快/确定性，勿用思考模式模型
# （思考模型不支持强制 tool_choice，会使 with_structured_output 的
#  function_calling 方式报 400；详见 eval/faithfulness.py 注释）
LLM_JUDGE_MODEL=deepseek-chat

# ---------- Embedding：阿里云百炼 DashScope（OpenAI 兼容接口） ----------
EMBEDDING_PROVIDER=dashscope
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=sk-your-dashscope-api-key
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3

# ---------- RAG 参数 ----------
DATA_DIR=./data
CHROMA_PERSIST_DIR=./chroma_db
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=4
# 小语料下 LLM 重排实测为负优化（README 第六节），默认关闭；语料扩大后可置 true 复测
ENABLE_RE_RANK=false

# ---------- 会话与限流 ----------
# 并发工具调用 / 并发请求的信号量上限
MAX_CONCURRENCY=5

# ---------- MCP Client（可选，未配置则跳过 mcp_client 演示） ----------
# 远程 MCP Server 的 Streamable HTTP 端点（Java 版服务端示例见 src/finrag/mcp_client.py 文件头注释）
MCP_SERVER_URL=
